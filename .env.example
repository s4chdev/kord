BOT_TOKEN=
GUILD_ID=

# Voice channel "status" line: use custom :kord: (TruthGOD) instead of 🎵. Bot must share a server with the emoji, or set an id:
# KORD_EMOJI_ID=123456789012345678
# Or the full token: KORD_VOICE_STATUS_EMOJI=<:kord:123456789012345678>

LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
# Lavalink server: copy this file to .env, then run `npm run lavalink:download` once and `npm run lavalink:start` (config in lavalink/application.yml; password must match).
# Kord tries Lavalink first for any URL your node supports (e.g. YouTube, SoundCloud, HTTP streams).
# If that fails, share links may resolve via Deezer API, Apple iTunes lookup, or Song.link then YouTube search.
# Lavalink JVM heap (default 2g). A 1 GB VPS needs something like 512m.
# LAVALINK_HEAP=2g
# Pre-touch the whole heap at boot (smoother audio, but commits all of it immediately).
# Leave off on small VPS instances - it can exhaust RAM before the bot even starts.
# LAVALINK_PRETOUCH=1

# Cover art enrichment - tries iTunes Search first, then MusicBrainz + Cover Art Archive (single-track /play flows).
# Replaces YouTube-style thumbnails when possible. Set to 0 to disable. Use a real contact URL or email for MusicBrainz User-Agent.
# MUSICBRAINZ_COVER_ART=1
# MUSICBRAINZ_CONTACT=https://your-site-or-repo.example

# AI chat: powers /ask, /explain and the optional /queue vibe line
# works with any OpenAI-compatible chat completions API (openai, groq, openrouter, together, ollama, lm studio...)
# local servers like ollama ignore the key, but set any value so ai turns on
AI_API_KEY=
# base url up to /v1, without /chat/completions. examples:
#   https://api.openai.com/v1
#   https://api.groq.com/openai/v1   (default)
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1        (ollama)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Max characters for track titles in embeds (20-200, default 50; truncated titles end with .....)
# MAX_TRACK_TITLE_LENGTH=50

# Local MP3 server for Lavalink (if not on same machine as bot)
# BOT_DISCONNECT_BASE_URL=http://127.0.0.1:3011

# optional: discord webhook logging
LOG_WEBHOOK_URL=
LOG_WEBHOOK_ONLY_WARN_ERROR=
LOG_WEBHOOK_DEDUPE_WINDOW_MS=
LOG_WEBHOOK_MAX_DESC_CHARS=
BOT_DISCONNECT_HTTP_PORT=





